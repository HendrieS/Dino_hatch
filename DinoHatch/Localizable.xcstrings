    "Diplodocus had one of the longest tails of any dinosaur, which it may have cracked like a whip!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diplodocus hatte einen der längsten Schwänze aller Dinosaurier, den er vielleicht wie eine Peitsche knallen ließ!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diplodocus had one of the longest tails of any dinosaur, which it may have cracked like a whip!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Diplodocus tenía una de las colas más largas de todos los dinosaurios, que quizás chasqueaba como un látigo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Diplodocus avait l'une des plus longues queues de tous les dinosaures, qu'il faisait peut-être claquer comme un fouet !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diplodocus had een van de langste staarten van alle dinosaurussen, die hij mogelijk liet klappen als een zweep!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У диплодока был один из самых длинных хвостов среди всех динозавров, которым он, возможно, щёлкал, как кнутом!"
          }
        }
      }
    },
