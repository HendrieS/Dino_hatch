    "Quetzalcoatlus was a flying reptile as big as a small airplane, the largest flier ever known!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quetzalcoatlus war ein fliegendes Reptil, so groß wie ein kleines Flugzeug, der größte bekannte Flieger überhaupt!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quetzalcoatlus was a flying reptile as big as a small airplane, the largest flier ever known!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Quetzalcóatlus era un reptil volador tan grande como un pequeño avión, el volador más grande jamás conocido!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quetzalcoatlus était un reptile volant aussi grand qu'un petit avion, le plus grand animal volant jamais connu !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Quetzalcoatlus was een vliegend reptiel zo groot als een klein vliegtuig, de grootste vlieger ooit bekend!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кетцалькоатль был летающим ящером размером с небольшой самолёт — самым крупным летающим существом из всех известных!"
          }
        }
      }
    },
