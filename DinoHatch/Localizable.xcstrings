    "Allosaurus was one of the top predators of its time, with sharp teeth like curved knives!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Allosaurus war einer der größten Raubtiere seiner Zeit, mit scharfen Zähnen wie gebogene Messer!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allosaurus was one of the top predators of its time, with sharp teeth like curved knives!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Alosaurio fue uno de los mayores depredadores de su época, con dientes afilados como cuchillos curvos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Allosaure était l'un des plus grands prédateurs de son époque, avec des dents acérées comme des couteaux courbés !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Allosaurus was een van de grootste roofdieren van zijn tijd, met scherpe tanden als gebogen messen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аллозавр был одним из главных хищников своего времени с острыми зубами, как изогнутые ножи!"
          }
        }
      }
    },
