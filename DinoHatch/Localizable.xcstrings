      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Braquiosaurio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaure" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaurus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Брахиозавр" } }
      }
    },
    "Brachiosaurus had front legs longer than its back legs, kind of like a giraffe!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Brachiosaurus hatte vordere Beine, die länger waren als seine Hinterbeine, ein bisschen wie eine Giraffe!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaurus had front legs longer than its back legs, kind of like a giraffe!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Braquiosaurio tenía las patas delanteras más largas que las traseras, un poco como una jirafa!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Brachiosaure avait des pattes avant plus longues que ses pattes arrière, un peu comme une girafe !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Brachiosaurus had voorpoten die langer waren dan zijn achterpoten, een beetje zoals een giraffe!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У брахиозавра передние ноги были длиннее задних, немного как у жирафа!" } }
      }
    },
    "Cancel Timer" : {
      "localizations" : {
