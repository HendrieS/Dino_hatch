    "Oviraptor means 'egg thief,' but scientists later found it was actually caring for its own nest!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oviraptor bedeutet „Eierdieb“, aber Wissenschaftler fanden später heraus, dass er tatsächlich sein eigenes Nest beschützte!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oviraptor means 'egg thief,' but scientists later found it was actually caring for its own nest!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Oviraptor significa 'ladrón de huevos', pero los científicos descubrieron después que en realidad cuidaba su propio nido!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oviraptor signifie « voleur d'œufs », mais les scientifiques ont découvert plus tard qu'il protégeait en fait son propre nid !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oviraptor betekent 'eierdief', maar wetenschappers ontdekten later dat hij eigenlijk voor zijn eigen nest zorgde!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Овираптор означает «похититель яиц», но учёные позже выяснили, что на самом деле он заботился о собственном гнезде!"
          }
        }
      }
    },
    "Pachycephalosaurus": {
