    "Set a timer and watch\nan egg hatch!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Stelle einen Timer ein und sieh zu,\nwie ein Ei ausschlüpft!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Set a timer and watch\nan egg hatch!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Configura un temporizador y mira\ncómo se abre un huevo!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglez une minuterie et regardez\nun œuf éclore !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Stel een timer in en kijk hoe\neen ei uitkomt!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установи таймер и посмотри,\nкак вылупится яйцо!" } }
      }
    },
    "Set a wake-up time and hatch\na dinosaur when you open the app!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Stelle eine Weckzeit ein und lass\nbeim Öffnen der App einen Dinosaurier schlüpfen!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Set a wake-up time and hatch\na dinosaur when you open the app!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Configura una hora para despertar y\nabre la app para que nazca un dinosaurio!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglez une heure de réveil et faites éclore\nun dinosaure en ouvrant l'appli !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Stel een wektijd in en laat een dinosaurus\nuitkomen als je de app opent!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установи время пробуждения — и когда\nоткроешь приложение, вылупится динозавр!" } }
      }
    },
    "Spinosaurus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Espinosaurio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaure" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaurus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Спинозавр" } }
      }
    },
    "Spinosaurus had a huge sail on its back and loved to swim and hunt fish!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Spinosaurus hatte ein riesiges Segel auf dem Rücken und liebte es, zu schwimmen und Fische zu jagen!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaurus had a huge sail on its back and loved to swim and hunt fish!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Espinosaurio tenía una enorme vela en la espalda y le encantaba nadar y cazar peces!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Spinosaure avait une immense voile sur le dos et adorait nager et chasser des poissons !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Spinosaurus had een enorm zeil op zijn rug en hield ervan te zwemmen en vissen te vangen!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У спинозавра был огромный «парус» на спине, и он любил плавать и охотиться на рыбу!" } }
      }
    },
    "Start Timer" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Timer starten" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Timer" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Iniciar temporizador" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Démarrer la minuterie" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Timer starten" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запустить таймер" } }
      }
    },
    "Stegosaurus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Stegosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stegosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Estegosaurio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Stégosaure" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Stegosaurus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Стегозавр" } }
      }
    },
    "Stegosaurus had bony plates on its back and dangerous spikes on its tail called a thagomizer!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Stegosaurus hatte knöcherne Platten auf dem Rücken und gefährliche Stacheln am Schwanz, den sogenannten Thagomizer!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stegosaurus had bony plates on its back and dangerous spikes on its tail called a thagomizer!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Estegosaurio tenía placas óseas en la espalda y peligrosas púas en la cola llamadas tagomizador!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Stégosaure avait des plaques osseuses sur le dos et des pointes dangereuses sur la queue appelées thagomizer !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Stegosaurus had benen platen op zijn rug en gevaarlijke stekels op zijn staart, de thagomizer genoemd!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У стегозавра были костяные пластины на спине и опасные шипы на хвосте, называемые тагомайзером!" } }
      }
    },
    "T-Rex had teeth as long as bananas and one of the strongest bites of any animal ever!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der T-Rex hatte Zähne, so lang wie Bananen, und einen der stärksten Bisse aller Tiere!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "T-Rex had teeth as long as bananas and one of the strongest bites of any animal ever!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El T-Rex tenía dientes tan largos como plátanos y una de las mordidas más fuertes de todos los animales!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le T-Rex avait des dents aussi longues que des bananes et l'une des morsures les plus puissantes de tous les animaux !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "T-Rex had tanden zo lang als bananen en een van de sterkste beten van alle dieren!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У тираннозавра были зубы длиной с банан и один из самых сильных укусов среди всех животных!" } }
      }
    },
    "Time to wake up!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeit zum Aufwachen!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Time to wake up!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Hora de despertar!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "C'est l'heure de se réveiller !" } },
