    "Ankylosaurus was covered in bony armor and had a big club at the end of its tail!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ankylosaurus war mit knöcherner Rüstung bedeckt und hatte eine große Keule am Ende seines Schwanzes!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankylosaurus was covered in bony armor and had a big club at the end of its tail!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Anquilosaurio estaba cubierto de armadura ósea y tenía una gran maza al final de la cola!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Ankylosaure était recouvert d'une armure osseuse et avait une grosse massue au bout de la queue !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankylosaurus was bedekt met benen pantser en had een grote knots aan het einde van zijn staart!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анкилозавр был покрыт костяной бронёй, а на конце хвоста у него была большая булава!"
          }
        }
      }
    },
