    "No name, birthday, email, photos, or location are ever asked for or stored.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Name, Geburtstag, E-Mail, Fotos oder Standort werden nie abgefragt oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name, birthday, email, photos, or location are ever asked for or stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se pide ni se guarda el nombre, la fecha de nacimiento, el correo, fotos ni la ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nom, date de naissance, e-mail, photo ou position n'est jamais demandé ni conservé."
