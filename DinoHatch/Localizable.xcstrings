    "Apatosaurus, once called Brontosaurus, was so huge that a single footprint could be bigger than a bathtub!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apatosaurus, früher Brontosaurus genannt, war so riesig, dass ein einziger Fußabdruck größer als eine Badewanne sein konnte!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apatosaurus, once called Brontosaurus, was so huge that a single footprint could be bigger than a bathtub!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Apatosaurio, antes llamado Brontosaurio, era tan enorme que una sola huella podía ser más grande que una bañera!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apatosaurus, autrefois appelé Brontosaurus, était si immense qu'une seule empreinte de pas pouvait être plus grande qu'une baignoire !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apatosaurus, vroeger Brontosaurus genoemd, was zo enorm dat één enkele voetafdruk groter kon zijn dan een badkuip!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Апатозавр, которого раньше называли бронтозавром, был настолько огромным, что один его след мог быть больше ванны!"
          }
        }
      }
    },
