    "A dinosaur egg is ready to hatch! Open Dino Hatch in the next 15 minutes to see who it is.": {
      "comment": "Alarm notification body",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Dinosaurier-Ei ist bereit zum Schlüpfen! Öffne Dino Hatch in den nächsten 15 Minuten, um zu sehen, wer es ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dinosaur egg is ready to hatch! Open Dino Hatch in the next 15 minutes to see who it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Un huevo de dinosaurio está listo para nacer! Abre Dino Hatch en los próximos 15 minutos para ver quién es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un œuf de dinosaure est prêt à éclore ! Ouvre Dino Hatch dans les 15 prochaines minutes pour découvrir qui c'est."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een dino-ei klaar om uit te komen! Open Dino Hatch binnen de komende 15 minuten om te zien wie het is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яйцо динозавра готово вылупиться! Открой Dino Hatch в течение следующих 15 минут, чтобы узнать, кто это."
          }
        }
      }
    },
