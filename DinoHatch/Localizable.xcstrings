        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diplodocus had een van de langste staarten van alle dinosaurussen, die hij mogelijk liet klappen als een zweep!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У диплодока был один из самых длинных хвостов среди всех динозавров, которым он, возможно, щёлкал, как кнутом!"
