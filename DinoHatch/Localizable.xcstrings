    "Stegosaurus had bony plates on its back and dangerous spikes on its tail called a thagomizer!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stegosaurus hatte knöcherne Platten auf dem Rücken und gefährliche Stacheln am Schwanz, den sogenannten Thagomizer!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegosaurus had bony plates on its back and dangerous spikes on its tail called a thagomizer!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Estegosaurio tenía placas óseas en la espalda y peligrosas púas en la cola llamadas tagomizador!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Stégosaure avait des plaques osseuses sur le dos et des pointes dangereuses sur la queue appelées thagomizer !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegosaurus had benen platen op zijn rug en gevaarlijke stekels op zijn staart, de thagomizer genoemd!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У стегозавра были костяные пластины на спине и опасные шипы на хвосте, называемые тагомайзером!"
          }
        }
      }
    },
