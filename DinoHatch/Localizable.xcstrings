    "Erases the dinosaur collection, timer, and alarm settings, and asks for the child's age again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Dinosammlung, den Timer und die Weckereinstellungen und fragt erneut nach dem Alter des Kindes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases the dinosaur collection, timer, and alarm settings, and asks for the child's age again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la colección de dinosaurios, el temporizador y los ajustes de la alarma, y vuelve a preguntar la edad del niño o niña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface la collection de dinosaures, le minuteur et les réglages de l'alarme, puis redemande l'âge de l'enfant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist de dinocollectie, timer en wekkerinstellingen, en vraagt opnieuw naar de leeftijd van het kind."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет коллекцию динозавров, настройки таймера и будильника и снова запрашивает возраст ребёнка."
          }
        }
      }
    },
    "Everything lives only on this device. There's no account, no cloud sync, no analytics, and no ads — the app doesn't need an internet connection to work, and nothing is ever sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt nur auf diesem Gerät. Es gibt kein Konto, keine Cloud-Synchronisierung, keine Analyse und keine Werbung — die App funktioniert ohne Internetverbindung, und es wird nie etwas irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything lives only on this device. There's no account, no cloud sync, no analytics, and no ads — the app doesn't need an internet connection to work, and nothing is ever sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo permanece solo en este dispositivo. No hay cuenta, ni sincronización en la nube, ni análisis, ni anuncios: la app funciona sin conexión a internet y nunca se envía nada a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste uniquement sur cet appareil. Pas de compte, pas de synchronisation cloud, pas d'analyse, pas de publicité — l'application fonctionne sans connexion internet et rien n'est jamais envoyé où que ce soit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft alleen op dit apparaat. Er is geen account, geen cloudsynchronisatie, geen analyse en geen advertenties — de app werkt zonder internetverbinding en er wordt nooit iets ergens naartoe verstuurd."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные остаются только на этом устройстве. Нет аккаунта, синхронизации с облаком, аналитики и рекламы — приложению не нужен интернет, и никакие данные никуда не отправляются."
          }
        }
      }
    },
