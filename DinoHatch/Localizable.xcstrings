    "Erases the dinosaur collection, timer, and alarm settings, and asks for the child's age again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Dinosammlung, den Timer und die Weckereinstellungen und fragt erneut nach dem Alter des Kindes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases the dinosaur collection, timer, and alarm settings, and asks for the child's age again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la colección de dinosaurios, el temporizador y los ajustes de la alarma, y vuelve a preguntar la edad del niño o niña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
