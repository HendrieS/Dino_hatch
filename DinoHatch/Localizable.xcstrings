    "A dinosaur egg is ready to hatch! Open Dino Hatch to see who it is." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein Dinosaurier-Ei ist bereit zum Schlüpfen! Öffne Dino Hatch, um zu sehen, wer es ist." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A dinosaur egg is ready to hatch! Open Dino Hatch to see who it is." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Un huevo de dinosaurio está listo para nacer! Abre Dino Hatch para ver quién es." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Un œuf de dinosaure est prêt à éclore ! Ouvre Dino Hatch pour découvrir qui c'est." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Er is een dino-ei klaar om uit te komen! Open Dino Hatch om te zien wie het is." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Яйцо динозавра готово вылупиться! Открой Dino Hatch, чтобы узнать, кто это." } }
      }
    },
    "A dinosaur hatched!" : {
