    "Dreadnoughtus means 'fears nothing' — it was so enormous that fully grown, no predator could ever have taken it down!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreadnoughtus bedeutet „fürchtet nichts“ — er war so riesig, dass ihn ausgewachsen kein Raubtier je hätte erlegen können!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreadnoughtus means 'fears nothing' — it was so enormous that fully grown, no predator could ever have taken it down!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Dreadnoughtus significa 'no teme nada' — era tan enorme que, ya adulto, ningún depredador podría haberlo derribado!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreadnoughtus signifie « qui ne craint rien » — il était si énorme qu'une fois adulte, aucun prédateur n'aurait pu le vaincre !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreadnoughtus betekent 'vreest niets' — hij was zo enorm dat volgroeid geen enkel roofdier hem ooit had kunnen vellen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дреднотус означает «не боящийся ничего» — он был настолько огромен, что взрослую особь не смог бы одолеть ни один хищник!"
          }
        }
      }
    },
