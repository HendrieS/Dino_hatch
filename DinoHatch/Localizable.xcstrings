    "Open the app within 15 minutes of your alarm to hatch a dinosaur!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App innerhalb von 15 Minuten nach deinem Wecker, um einen Dinosaurier schlüpfen zu lassen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
