    "Triceratops had three horns and a giant bony frill to protect its neck from predators!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Triceratops hatte drei Hörner und einen riesigen Knochenkragen, um seinen Hals vor Fressfeinden zu schützen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Triceratops had three horns and a giant bony frill to protect its neck from predators!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Triceratops tenía tres cuernos y un enorme volante óseo para proteger su cuello de los depredadores!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Tricératops avait trois cornes et une immense collerette osseuse pour protéger son cou des prédateurs !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Triceratops had drie hoorns en een enorme benen kraag om zijn nek te beschermen tegen roofdieren!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У трицератопса было три рога и огромный костяной воротник, защищавший шею от хищников!"
          }
        }
      }
    },
