        "es" : { "stringUnit" : { "state" : "translated", "value" : "Suelta para ver la piel" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Relâchez pour voir la peau" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Loslaten om de huid te zien" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Отпусти, чтобы увидеть кожу" } }
