    "Styracosaurus had a ring of long spikes around its frill, making it look like it was wearing a spiky crown!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus hatte einen Kranz aus langen Stacheln um seinen Nackenschild, sodass es aussah, als würde er eine stachelige Krone tragen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus had a ring of long spikes around its frill, making it look like it was wearing a spiky crown!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Estiracosaurio tenía un anillo de largas púas alrededor de su gola, lo que lo hacía parecer que llevaba una corona con pinchos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus avait un anneau de longues pointes autour de sa collerette, ce qui lui donnait l'air de porter une couronne hérissée de pointes !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus had een kring van lange stekels rond zijn kraag, waardoor het leek alsof hij een stekelige kroon droeg!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У стиракозавра было кольцо длинных шипов вокруг воротника, из-за чего казалось, что он носит колючую корону!"
          }
        }
      }
    },
