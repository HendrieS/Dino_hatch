    "Therizinosaurus was a plant-eating dinosaur with enormous claws as long as swords!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Therizinosaurus war ein pflanzenfressender Dinosaurier mit riesigen Krallen, so lang wie Schwerter!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Therizinosaurus was a plant-eating dinosaur with enormous claws as long as swords!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Terizinosaurio era un dinosaurio herbívoro con enormes garras tan largas como espadas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Therizinosaurus était un dinosaure herbivore avec d'énormes griffes aussi longues que des épées !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Therizinosaurus was een planteneter met enorme klauwen, zo lang als zwaarden!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теризинозавр был травоядным динозавром с огромными когтями, длинными, как мечи!"
          }
        }
      }
    },
