    "Coelophysis was one of the very first dinosaurs, living over 200 million years ago and hunting in packs!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coelophysis war einer der allerersten Dinosaurier, lebte vor über 200 Millionen Jahren und jagte in Rudeln!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coelophysis was one of the very first dinosaurs, living over 200 million years ago and hunting in packs!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Celofisis fue uno de los primerísimos dinosaurios, vivió hace más de 200 millones de años y cazaba en manadas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coelophysis était l'un des tout premiers dinosaures, vivant il y a plus de 200 millions d'années et chassant en meute !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coelophysis was een van de allereerste dinosaurussen, leefde meer dan 200 miljoen jaar geleden en jaagde in roedels!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целофизис был одним из самых первых динозавров, жил более 200 миллионов лет назад и охотился стаями!"
