    "Patagotitan was as long as three school buses lined up end to end — one of the biggest animals to ever walk on land!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Patagotitan war so lang wie drei Schulbusse hintereinander — eines der größten Tiere, die je auf dem Land gelebt haben!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patagotitan was as long as three school buses lined up end to end — one of the biggest animals to ever walk on land!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Patagotitán era tan largo como tres autobuses escolares puestos en fila — uno de los animales más grandes que jamás caminó sobre la tierra!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Patagotitan était aussi long que trois bus scolaires mis bout à bout — l'un des plus grands animaux à avoir jamais marché sur terre !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Patagotitan was zo lang als drie schoolbussen achter elkaar — een van de grootste dieren die ooit over land liepen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Патаготитан был длиной с три школьных автобуса, поставленных друг за другом, — одно из крупнейших животных, когда-либо ходивших по суше!"
          }
        }
      }
    },
    "Plateosaurus": {
      "extractionState": "stale",
      "localizations": {
        "de": {
