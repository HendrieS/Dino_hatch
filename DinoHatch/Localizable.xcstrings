    "Velociraptors were fast, smart hunters that likely had feathers, just like birds today!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Velociraptoren waren schnelle, kluge Jäger, die wahrscheinlich Federn hatten, genau wie die Vögel heute!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Velociraptors were fast, smart hunters that likely had feathers, just like birds today!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Los velocirraptores eran cazadores rápidos e inteligentes que probablemente tenían plumas, como las aves de hoy!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vélociraptors étaient des chasseurs rapides et intelligents qui avaient probablement des plumes, comme les oiseaux d'aujourd'hui !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Velociraptors waren snelle, slimme jagers die waarschijnlijk veren hadden, net als vogels vandaag!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Велоцирапторы были быстрыми и умными хищниками, у которых, вероятно, были перья, как у современных птиц!"
          }
        }
      }
    },
