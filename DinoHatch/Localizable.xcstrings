    "Baryonyx had a long crocodile-like snout and curved claws perfect for catching slippery fish!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baryonyx hatte eine lange, krokodilähnliche Schnauze und gebogene Krallen, perfekt zum Fangen glitschiger Fische!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baryonyx had a long crocodile-like snout and curved claws perfect for catching slippery fish!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Baryonyx tenía un hocico largo parecido al de un cocodrilo y garras curvas perfectas para atrapar peces resbaladizos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baryonyx avait un long museau semblable à celui d'un crocodile et des griffes recourbées parfaites pour attraper des poissons glissants !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baryonyx had een lange, krokodilachtige snuit en gebogen klauwen, perfect om gladde vissen te vangen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У бариониксa была длинная морда, похожая на крокодилью, и изогнутые когти, идеально подходящие для ловли скользкой рыбы!"
          }
        }
      }
    },
