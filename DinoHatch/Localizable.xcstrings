    "Notifications are off, but you'll still get a new dinosaur whenever you open the app after your alarm time." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Benachrichtigungen sind aus, aber du bekommst trotzdem einen neuen Dinosaurier, sobald du die App nach deiner Weckzeit öffnest." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications are off, but you'll still get a new dinosaur whenever you open the app after your alarm time." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las notificaciones están desactivadas, pero igual conseguirás un nuevo dinosaurio cuando abras la app después de tu hora de alarma." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les notifications sont désactivées, mais vous recevrez quand même un nouveau dinosaure en ouvrant l'appli après l'heure de l'alarme." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Meldingen staan uit, maar je krijgt nog steeds een nieuwe dinosaurus zodra je de app opent na je wektijd." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Уведомления отключены, но ты всё равно получишь нового динозавра, когда откроешь приложение после времени будильника." } }
      }
    },
