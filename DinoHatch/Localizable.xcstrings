    "Carnotaurus means 'meat-eating bull' and had two short horns above its eyes and tiny, stubby arms!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnotaurus bedeutet „fleischfressender Stier“ und hatte zwei kurze Hörner über den Augen sowie winzige, stummelige Arme!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnotaurus means 'meat-eating bull' and had two short horns above its eyes and tiny, stubby arms!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Carnotauro significa 'toro carnívoro' y tenía dos cuernos cortos sobre los ojos y brazos diminutos y rechonchos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnotaurus signifie « taureau carnivore » et avait deux courtes cornes au-dessus des yeux ainsi que de minuscules bras rabougris !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnotaurus betekent 'vleesetende stier' en had twee korte hoorns boven zijn ogen en piepkleine, stompe armpjes!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карнотавр означает «плотоядный бык», у него было два коротких рога над глазами и крошечные, короткие лапки!"
          }
        }
      }
    },
