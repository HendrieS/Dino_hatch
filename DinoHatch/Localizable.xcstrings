    "Compsognathus was about the size of a chicken, making it one of the smallest known dinosaurs!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Compsognathus war etwa so groß wie ein Huhn und damit einer der kleinsten bekannten Dinosaurier!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compsognathus was about the size of a chicken, making it one of the smallest known dinosaurs!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Compsognato era del tamaño de una gallina, lo que lo convierte en uno de los dinosaurios más pequeños conocidos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Compsognathus avait à peu près la taille d'une poule, ce qui en fait l'un des plus petits dinosaures connus !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Compsognathus was ongeveer zo groot als een kip, waardoor het een van de kleinste bekende dinosaurussen is!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компсогнат был размером примерно с курицу, что делает его одним из самых маленьких известных динозавров!"
          }
        }
      }
    },
