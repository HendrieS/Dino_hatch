    "Styracosaurus had a ring of long spikes around its frill, making it look like it was wearing a spiky crown!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus hatte einen Kranz aus langen Stacheln um seinen Nackenschild, sodass es aussah, als würde er eine stachelige Krone tragen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus had a ring of long spikes around its frill, making it look like it was wearing a spiky crown!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Estiracosaurio tenía un anillo de largas púas alrededor de su gola, lo que lo hacía parecer que llevaba una corona con pinchos!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus avait un anneau de longues pointes autour de sa collerette, ce qui lui donnait l'air de porter une couronne hérissée de pointes !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Styracosaurus had een kring van lange stekels rond zijn kraag, waardoor het leek alsof hij een stekelige kroon droeg!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У стиракозавра было кольцо длинных шипов вокруг воротника, из-за чего казалось, что он носит колючую корону!"
          }
        }
      }
    },
    "T-Rex had teeth as long as bananas and one of the strongest bites of any animal ever!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der T-Rex hatte Zähne, so lang wie Bananen, und einen der stärksten Bisse aller Tiere!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "T-Rex had teeth as long as bananas and one of the strongest bites of any animal ever!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El T-Rex tenía dientes tan largos como plátanos y una de las mordidas más fuertes de todos los animales!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le T-Rex avait des dents aussi longues que des bananes et l'une des morsures les plus puissantes de tous les animaux !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "T-Rex had tanden zo lang als bananen en een van de sterkste beten van alle dieren!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тираннозавра были зубы длиной с банан и один из самых сильных укусов среди всех животных!"
          }
        }
      }
    },
