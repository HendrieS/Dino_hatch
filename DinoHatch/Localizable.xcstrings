    "Gallimimus looked like a giant ostrich and could run incredibly fast on its long, skinny legs!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallimimus sah aus wie ein riesiger Strauß und konnte auf seinen langen, dünnen Beinen unglaublich schnell rennen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallimimus looked like a giant ostrich and could run incredibly fast on its long, skinny legs!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Galimimo parecía un avestruz gigante y podía correr increíblemente rápido con sus patas largas y delgadas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallimimus ressemblait à une autruche géante et pouvait courir incroyablement vite sur ses longues pattes fines !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallimimus zag eruit als een gigantische struisvogel en kon ongelooflijk snel rennen op zijn lange, dunne poten!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Галлимим был похож на гигантского страуса и мог невероятно быстро бегать на своих длинных, тонких ногах!"
          }
        }
      }
    },
