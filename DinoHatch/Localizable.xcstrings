        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Птеранодон" } }
      }
    },
    "Pteranodon wasn't a dinosaur at all, it was a flying reptile that soared over the oceans!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Pteranodon war überhaupt kein Dinosaurier, sondern ein fliegendes Reptil, das über die Ozeane glitt!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pteranodon wasn't a dinosaur at all, it was a flying reptile that soared over the oceans!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Pteranodon no era un dinosaurio, sino un reptil volador que planeaba sobre los océanos!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Ptéranodon n'était pas du tout un dinosaure, c'était un reptile volant qui planait au-dessus des océans !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Pteranodon was helemaal geen dinosaurus, het was een vliegend reptiel dat over de oceanen zweefde!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Птеранодон вовсе не был динозавром — это была летающая рептилия, парившая над океанами!" } }
      }
    },
    "Release to see skin" : {
      "localizations" : {
