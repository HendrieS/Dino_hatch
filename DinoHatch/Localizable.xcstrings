    "Spinosaurus had a huge sail on its back and loved to swim and hunt fish!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spinosaurus hatte ein riesiges Segel auf dem Rücken und liebte es, zu schwimmen und Fische zu jagen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinosaurus had a huge sail on its back and loved to swim and hunt fish!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El Espinosaurio tenía una enorme vela en la espalda y le encantaba nadar y cazar peces!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Spinosaure avait une immense voile sur le dos et adorait nager et chasser des poissons !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spinosaurus had een enorm zeil op zijn rug en hield ervan te zwemmen en vissen te vangen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У спинозавра был огромный «парус» на спине, и он любил плавать и охотиться на рыбу!"
          }
        }
      }
    },
