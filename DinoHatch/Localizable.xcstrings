    "Titanosaurus gave its name to the titanosaurs, an entire group of the biggest plant-eating dinosaurs that ever roamed the Earth!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titanosaurus gab den Titanosauriern ihren Namen, einer ganzen Gruppe der größten pflanzenfressenden Dinosaurier, die je die Erde durchstreiften!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titanosaurus gave its name to the titanosaurs, an entire group of the biggest plant-eating dinosaurs that ever roamed the Earth!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Titanosaurio dio su nombre a los titanosaurios, todo un grupo de los dinosaurios herbívoros más grandes que jamás recorrieron la Tierra!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Titanosaure a donné son nom aux titanosaures, tout un groupe des plus grands dinosaures herbivores ayant jamais parcouru la Terre !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titanosaurus gaf zijn naam aan de titanosauriërs, een hele groep van de grootste planteneters die ooit over de aarde liepen!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Титанозавр дал имя целой группе титанозавров — самым большим растительноядным динозаврам, когда-либо ходившим по Земле!"
          }
        }
      }
    },
