    "Pachycephalosaurus had a thick dome skull that may have been used for head-butting contests!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Pachycephalosaurus hatte einen dicken, kuppelförmigen Schädel, den er vielleicht für Kopfstoß-Wettkämpfe benutzte!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pachycephalosaurus had a thick dome skull that may have been used for head-butting contests!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Paquicefalosaurio tenía un grueso cráneo en forma de cúpula que quizás usaba en combates a cabezazos!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Pachycéphalosaure avait un épais crâne en forme de dôme, peut-être utilisé pour des combats à coups de tête !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Pachycephalosaurus had een dikke koepelvormige schedel die mogelijk werd gebruikt bij kopstoot-gevechten!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У пахицефалозавра был толстый куполообразный череп, которым он, возможно, бодался с соперниками!" } }
      }
    },
    "Parasaurolophus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolophus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolophus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolofo" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolophus" } },
