    "Pachycephalosaurus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pachycephalosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pachycephalosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Paquicefalosaurio" } },
