    "Iguanodon had a sharp thumb spike on each hand, maybe used for defense or finding food!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Iguanodon hatte an jeder Hand einen scharfen Daumendorn, der vielleicht zur Verteidigung oder Nahrungssuche diente!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Iguanodon had a sharp thumb spike on each hand, maybe used for defense or finding food!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Iguanodonte tenía una afilada púa en el pulgar de cada mano, quizás usada para defenderse o buscar comida!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'Iguanodon avait une pointe acérée sur le pouce de chaque main, peut-être utilisée pour se défendre ou trouver de la nourriture !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Iguanodon had een scherpe duimstekel aan elke hand, mogelijk gebruikt om zich te verdedigen of voedsel te vinden!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У игуанодона на каждой руке был острый шип на большом пальце — возможно, для защиты или поиска еды!" } }
      }
    },
