        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Паразауролоф" } }
      }
    },
    "Parasaurolophus had a long curved crest that it may have used to make loud honking sounds!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Parasaurolophus hatte einen langen, gebogenen Kamm, mit dem er wahrscheinlich laute, hupende Geräusche machte!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolophus had a long curved crest that it may have used to make loud honking sounds!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Parasaurolofo tenía una larga cresta curvada que quizás usaba para hacer fuertes sonidos como bocinazos!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le Parasaurolophus avait une longue crête courbée qu'il utilisait peut-être pour émettre de forts sons semblables à un klaxon !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Parasaurolophus had een lange gebogen kam die hij mogelijk gebruikte om luide, toeterende geluiden te maken!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У паразауролофа был длинный изогнутый гребень, которым он, возможно, издавал громкие трубные звуки!" } }
      }
    },
    "Pteranodon" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Pteranodon" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pteranodon" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Pteranodon" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ptéranodon" } },
