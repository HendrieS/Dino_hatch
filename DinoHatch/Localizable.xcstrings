    "Plateosaurus was one of the first giant plant-eating dinosaurs and could rear up on its back legs to reach tall leaves!": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateosaurus war einer der ersten riesigen pflanzenfressenden Dinosaurier und konnte sich auf die Hinterbeine stellen, um hohe Blätter zu erreichen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateosaurus was one of the first giant plant-eating dinosaurs and could rear up on its back legs to reach tall leaves!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Plateosaurio fue uno de los primeros dinosaurios herbívoros gigantes y podía levantarse sobre sus patas traseras para alcanzar las hojas altas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateosaurus était l'un des premiers dinosaures herbivores géants et pouvait se dresser sur ses pattes arrière pour atteindre les feuilles hautes !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plateosaurus was een van de eerste reusachtige planteneters onder de dinosaurussen en kon op zijn achterpoten gaan staan om hoge bladeren te bereiken!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платеозавр был одним из первых гигантских травоядных динозавров и мог вставать на задние лапы, чтобы дотянуться до высоких листьев!"
          }
        }
      }
    },
