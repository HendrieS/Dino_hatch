    "Allosaurus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Allosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Alosaurio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Allosaure" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Allosaurus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Аллозавр" } }
      }
    },
    "Allosaurus was one of the top predators of its time, with sharp teeth like curved knives!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Allosaurus war einer der größten Raubtiere seiner Zeit, mit scharfen Zähnen wie gebogene Messer!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allosaurus was one of the top predators of its time, with sharp teeth like curved knives!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Alosaurio fue uno de los mayores depredadores de su época, con dientes afilados como cuchillos curvos!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'Allosaure était l'un des plus grands prédateurs de son époque, avec des dents acérées comme des couteaux courbés !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Allosaurus was een van de grootste roofdieren van zijn tijd, met scherpe tanden als gebogen messen!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Аллозавр был одним из главных хищников своего времени с острыми зубами, как изогнутые ножи!" } }
      }
    },
    "Ankylosaurus" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaurus" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaurus" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Anquilosaurio" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaure" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaurus" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Анкилозавр" } }
      }
    },
    "Ankylosaurus was covered in bony armor and had a big club at the end of its tail!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Ankylosaurus war mit knöcherner Rüstung bedeckt und hatte eine große Keule am Ende seines Schwanzes!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaurus was covered in bony armor and had a big club at the end of its tail!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡El Anquilosaurio estaba cubierto de armadura ósea y tenía una gran maza al final de la cola!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'Ankylosaure était recouvert d'une armure osseuse et avait une grosse massue au bout de la queue !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Ankylosaurus was bedekt met benen pantser en had een grote knots aan het einde van zijn staart!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Анкилозавр был покрыт костяной бронёй, а на конце хвоста у него была большая булава!" } }
      }
    },
    "Awesome!" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Klasse!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Awesome!" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¡Genial!" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Génial !" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Geweldig!" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Круто!" } }
      }
    },
